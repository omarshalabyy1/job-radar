# Copy to .env and fill in. .env is gitignored: it never leaves this laptop.

# The warehouse's password (letters and digits), any value you choose before the first `up`.
WAREHOUSE_PASSWORD=

# The daily email, sent from Gmail with an app password (Google Account > Security >
# 2-Step Verification > App passwords), never your real password. MAIL_TO empty = GMAIL_USER.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TO=

# Your inboxes to read job alerts from, read-only:
# address:app-password[:imap-host], comma-separated. Gmail, Yahoo and iCloud take an app password;
# give the IMAP host for any other provider. Example:
# MAILBOXES=me@gmail.com:abcdefghijklmnop,other@yahoo.com:qrstuvwxyzabcdef
MAILBOXES=

# Optional: Jooble's free API key (https://jooble.org/api/about) adds the local boards it indexes.
JOOBLE_API_KEY=
