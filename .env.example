# Copy to .env and fill in. .env is gitignored: it never leaves this laptop.

# The warehouse's password (letters and digits), any value you choose before the first `up`.
WAREHOUSE_PASSWORD=

# The daily email, sent from Gmail with an app password (Google Account > Security >
# 2-Step Verification > App passwords), never your real password. MAIL_TO empty = GMAIL_USER.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TO=

# Your inboxes to read job alerts from, read-only:
# address:app-password[:imap-host], comma-separated. Gmail, Yahoo and iCloud take an app password;
# give the IMAP host for any other provider. track_applications reads the Gmail ones too. Example:
# MAILBOXES=me@gmail.com:abcdefghijklmnop,other@yahoo.com:qrstuvwxyzabcdef
MAILBOXES=
# Every email from these addresses or domains counts as news on an application (track_applications), whatever its
# subject: people who hire you directly. Comma-separated; "=Company" names the company of an email that names none
# (a domain alone names its own: acme-labs.example is Acme Labs). E.g. APPLICATION_SENDERS=acme-labs.example,jane@gmail.com=Acme Labs
APPLICATION_SENDERS=

# Optional: Jooble's free API key (https://jooble.org/api/about) adds the local boards it indexes.
JOOBLE_API_KEY=

# Optional: your Apify API token (Apify Console > Settings > API & Integrations) adds LinkedIn's
# public job search through an Apify Actor, paid per result (settings.yaml linkedin.max_jobs caps it).
APIFY_TOKEN=
# Several Apify accounts, comma-separated, in the order to use them: one at its usage limit hands the run to the next
APIFY_TOKENS=

# Where drafts, saved logins and digests go: docker-compose mounts this folder as the containers' output/ (the repo's
# own output/ when this is empty), and job_radar or a script run on the laptop writes to it, so a login saved by
# scripts/open_blocked.py reaches Airflow. Set it to keep output/ on another drive; empty = the repo's output/.
# JOB_RADAR_OUTPUT=E:/job-radar/output

# Optional: a Claude API key (platform.claude.com > API keys) lets grade_claude score the new jobs
# against your CVs (settings.yaml claude). Billed per token from your API credit.
ANTHROPIC_API_KEY=

# Phone pushes (ntfy.sh): a long random topic, the only secret; subscribe to it in the ntfy app. Empty: no pushes.
# A job graded 8+ in its first 12 hours since posted is pushed. E.g. NTFY_TOPIC=jobradar-3f9c1e7a52b44d0e
NTFY_TOPIC=
